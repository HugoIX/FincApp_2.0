<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="FincApp"
            android:textColor="@color/green_dark"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Offline field work mode"
            android:textColor="@color/text_dark"
            android:textSize="15sp" />


        <Button
            android:id="@+id/btnWakeAura"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/aura_button_bg"
            android:text="✨  Despertar AURA"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="AURA introduces itself and becomes the main assistant experience."
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="1. Select active farm"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFarms"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Select operational module"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCattle"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/module_button_bg"
            android:text="🐄  CATTLE\nRegister cattle module offline"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="19sp" />

        <Button
            android:id="@+id/btnSwine"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/module_button_bg"
            android:text="🐖  SWINE\nRegister swine module offline"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="19sp" />

        <Button
            android:id="@+id/btnPoultry"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/module_button_bg"
            android:text="🐔  POULTRY\nRegister poultry module offline"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="SQLite local DB initialized. Airplane mode supported."
            android:textColor="@color/green_dark"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
