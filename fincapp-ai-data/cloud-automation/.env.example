# =============================================================
# FincApp — Cloud Automation Environment Variables
# US-01-JUANPABLO | n8n Workflow Ingestion & LLM Gateway
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value below with your real credentials.
# 3. NEVER commit .env — it is blocked by .gitignore.
# =============================================================

# --- Supabase Project (Staging) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Supabase Direct DB — used in n8n Postgres node
SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_DB_SSL=true

# --- Webhook Security ---
# Generate a strong random token: openssl rand -hex 32
N8N_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_TOKEN

# --- LLM Provider ---
# Set LLM_PROVIDER to: openai | gemini | deepseek
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative)
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek (alternative)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-chat

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- SendGrid / SMTP ---
SENDGRID_API_KEY=SG.YOUR_SENDGRID_KEY
NOTIFICATION_EMAIL_FROM=noreply@fincapp.co

# --- n8n Instance (local or cloud) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
